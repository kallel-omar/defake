<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}DeFake{% endblock %}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% block stylesheets %}{% endblock %}
</head>

<body class="{% block body_class %}defake-page{% endblock %} d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark defake-navbar sticky-top">
    <div class="defake-header-grid" aria-hidden="true"></div>
    <div class="defake-header-scan" aria-hidden="true"></div>

    <div class="container defake-navbar-inner">

        <a class="navbar-brand defake-brand"
           href="{{ path('app_home') }}">
            <span class="defake-brand-symbol" aria-hidden="true">
                <span class="defake-brand-ring"></span>
                <span></span>
            </span>

            <span class="defake-brand-copy">
                <span class="defake-brand-name">DeFake</span>
                <span class="defake-brand-subtitle">Credibility Scanner</span>
            </span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#defakeNavbar"
            aria-controls="defakeNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="defakeNavbar">
            <div class="navbar-nav ms-auto align-items-lg-center defake-nav-links pt-3 pt-lg-0">
                <span class="defake-live-chip">
                    <span aria-hidden="true"></span>
                    Live Scanner
                </span>

            {% if app.user %}

                <a href="{{ path('app_history') }}"
                   class="nav-link defake-nav-link">
                    History
                </a>

                 {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_admin') }}" class="nav-link defake-nav-link">
                    Admin
                </a>
                {% endif %}
                

                <a href="{{ path('app_logout') }}"
                   class="nav-link defake-nav-link">
                    Logout
                </a>

            {% else %}

                <a href="{{ path('app_login') }}"
                   class="nav-link defake-nav-link">
                    Login
                </a>

                <a href="{{ path('app_register') }}"
                   class="btn defake-header-cta">
                    Sign Up
                </a>

            {% endif %}

            </div>
        </div>

    </div>
</nav>

<div class="container defake-flash-stack">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set alertClass = label == 'error' ? 'danger' : label %}

            <div class="alert alert-{{ alertClass }} alert-dismissible fade show defake-alert-surface" role="alert">
                {{ message }}

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert"
                        aria-label="Close">
                </button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<main class="flex-grow-1 defake-main">
    {% block body %}{% endblock %}
</main>

<footer class="defake-footer mt-auto">
    <div class="defake-footer-scan" aria-hidden="true"></div>

    <div class="container">
        <div class="defake-footer-inner">
            <div>
                <div class="defake-footer-brand">
                    <span class="defake-footer-orb" aria-hidden="true"></span>
                    DeFake
                </div>
                <div class="defake-footer-note">
                    AI-assisted credibility scanning for public claims and online content.
                </div>
            </div>

            <div class="defake-footer-disclaimer">
                <span class="defake-footer-label">Verification Notice</span>
                DeFake is an AI-assisted credibility tool. Always verify important information independently.
            </div>

            <div class="defake-footer-chips" aria-label="DeFake analysis pipeline">
                <span>Claims</span>
                <span>Evidence</span>
                <span>Sources</span>
            </div>

            <div class="defake-footer-links">
                <a href="{{ path('app_home') }}">New Scan</a>
                {% if app.user %}
                    <a href="{{ path('app_history') }}">History</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Login</a>
                {% endif %}
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
