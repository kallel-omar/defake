{% extends 'base.html.twig' %}

{% block title %}DeFake - AI Credibility Scanner{% endblock %}

{% block body_class %}defake-page defake-home-body{% endblock %}

{% block body %}
<div class="defake-home-shell">
    <section class="defake-hero defake-hero-redesigned">
        <div class="container">
            <div class="defake-home-intro">
                <div class="defake-home-intro-copy">
                    <div class="defake-kicker">AI-assisted credibility scanner</div>

                    <h1 class="defake-hero-title">
                        Detect misinformation before it spreads.
                    </h1>

                    <p class="defake-hero-copy">
                        Paste a claim, rumor, post text, or public statement. DeFake extracts the checkable claim, searches for evidence, and explains the result.
                    </p>

                    <div class="defake-hero-actions">
                        <a href="{{ path('app_text_check') }}" class="btn defake-btn defake-btn-primary">
                            Start With Text
                        </a>
                        <a href="{{ path('app_facebook_check') }}" class="btn defake-btn defake-btn-secondary">
                            Use Facebook Link
                        </a>
                    </div>
                </div>

                <div class="defake-home-signal-board" aria-label="DeFake scan pipeline">
                    <div class="defake-signal-board-header">
                        <span>Scan Path</span>
                        <strong>
                            {% if aiAnalysisAvailable %}
                                Online
                            {% else %}
                                Limited
                            {% endif %}
                        </strong>
                    </div>

                    <div class="defake-signal-track">
                        <div>
                            <span>01</span>
                            <strong>Claim</strong>
                            <small>Find the factual assertion</small>
                        </div>
                        <div>
                            <span>02</span>
                            <strong>Evidence</strong>
                            <small>Search public context</small>
                        </div>
                        <div>
                            <span>03</span>
                            <strong>Sources</strong>
                            <small>Filter weak signals</small>
                        </div>
                        <div>
                            <span>04</span>
                            <strong>Result</strong>
                            <small>Explain the verdict</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="defake-console-section" id="scan-console">
        <div class="container">
            <div class="defake-section-heading defake-console-heading">
                <p>Start here</p>
                <h2>Choose the clearest input you have.</h2>
            </div>

            <div class="defake-console-layout">
                <aside class="defake-guidance-rail" aria-label="Recommended DeFake workflow">
                    <div class="defake-guidance-item is-active">
                        <span>01</span>
                        <div>
                            <strong>Text is recommended</strong>
                            <p>Paste the claim or post text directly for the fastest and most reliable scan.</p>
                        </div>
                    </div>

                    <div class="defake-guidance-item">
                        <span>02</span>
                        <div>
                            <strong>Add context if useful</strong>
                            <p>Country and topic help when names, clubs, or local references are ambiguous.</p>
                        </div>
                    </div>

                    <div class="defake-guidance-item">
                        <span>03</span>
                        <div>
                            <strong>Review the report</strong>
                            <p>DeFake shows the claim, evidence signals, source quality, and explanation.</p>
                        </div>
                    </div>
                </aside>

                <article class="defake-scan-panel defake-scan-panel-primary">
                    <div class="defake-scan-panel-top">
                        <div>
                            <span class="defake-panel-eyebrow">Recommended</span>
                            <h3>Analyze text or claim</h3>
                        </div>
                        <div class="defake-reliability-chip">Best accuracy path</div>
                    </div>

                    <p class="defake-panel-copy">
                        Paste a claim, rumor, Facebook post text, article excerpt, or public statement.
                    </p>

                    {% if not aiAnalysisAvailable %}
                        <div class="alert defake-alert" role="alert">
                            {{ aiUnavailableMessage }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('app_text_check') }}" class="defake-form">
                        <input type="hidden" name="_token" value="{{ csrf_token('text_check') }}">

                        <div class="mb-3">
                            <label for="home_claim_text" class="form-label">
                                Claim or public text
                            </label>

                            <textarea
                                id="home_claim_text"
                                name="claim_text"
                                class="form-control defake-input defake-textarea"
                                rows="9"
                                minlength="8"
                                maxlength="5000"
                                required
                                placeholder="Example: The club won after an incorrect penalty decision."></textarea>
                        </div>

                        <div class="defake-context-grid">
                            <div>
                                <label for="home_context_country" class="form-label">
                                    Country or region <span>(optional)</span>
                                </label>

                                <select
                                    id="home_context_country"
                                    name="context_country"
                                    class="form-select defake-input">
                                    {% for countryCode, countryLabel in countryOptions %}
                                        <option value="{{ countryCode }}">{{ countryLabel }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div>
                                <label for="home_context_topic" class="form-label">
                                    Topic <span>(optional)</span>
                                </label>

                                <select
                                    id="home_context_topic"
                                    name="context_topic"
                                    class="form-select defake-input">
                                    <option value="">Not sure</option>
                                    <option value="sports">Sports</option>
                                    <option value="politics">Politics</option>
                                    <option value="health">Health</option>
                                    <option value="business">Business</option>
                                    <option value="technology">Technology</option>
                                    <option value="legal">Legal</option>
                                    <option value="weather">Weather</option>
                                    <option value="entertainment">Entertainment</option>
                                </select>
                            </div>
                        </div>

                        <div class="defake-action-row">
                            <button
                                type="submit"
                                class="btn defake-btn defake-btn-primary"
                                {% if not aiAnalysisAvailable %}disabled{% endif %}>
                                Analyze Text
                            </button>
                            <a href="{{ path('app_facebook_check') }}" class="btn defake-btn defake-btn-secondary">
                                Check Facebook Link
                            </a>
                        </div>
                    </form>
                </article>
            </div>
        </div>
    </section>

    <section class="defake-after-submit-section">
        <div class="container">
            <div class="defake-after-submit">
                <div class="defake-section-heading">
                    <p>After you submit</p>
                    <h2>DeFake turns messy content into a structured credibility report.</h2>
                </div>

                <div class="defake-after-grid">
                    <div>
                        <span>Extract</span>
                        <strong>Identifies the claim</strong>
                        <p>Separates the factual assertion from opinion, jokes, or extra commentary.</p>
                    </div>

                    <div>
                        <span>Search</span>
                        <strong>Finds public evidence</strong>
                        <p>Looks for sources related to the exact claim being checked.</p>
                    </div>

                    <div>
                        <span>Filter</span>
                        <strong>Checks source quality</strong>
                        <p>Weak or low-confidence evidence is separated from stronger signals.</p>
                    </div>

                    <div>
                        <span>Explain</span>
                        <strong>Shows the result</strong>
                        <p>Gives a verdict, score, evidence context, and reasoned explanation.</p>
                    </div>
                </div>
            </div>

            <div class="defake-disclaimer">
                DeFake is an AI-assisted credibility tool. It does not replace professional fact-checkers. Always verify important information independently.
            </div>
        </div>
    </section>
</div>
{% endblock %}
