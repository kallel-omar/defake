<div style="font-family: Arial, sans-serif; color: #1f2937; line-height: 1.5;">
    <h1 style="color: #111827; font-size: 24px; margin-bottom: 16px;">Reset your DeFake password</h1>

    <p>
        A password reset was requested for your DeFake account. Use the secure link below to choose a new password.
    </p>

    <p style="margin: 24px 0;">
        <a href="{{ url('app_reset_password', {token: resetToken.token}) }}"
           style="background: #dc3545; border-radius: 8px; color: #ffffff; display: inline-block; font-weight: 700; padding: 12px 18px; text-decoration: none;">
            Reset password
        </a>
    </p>

    <p>
        This link will expire in {{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}.
    </p>

    <p style="color: #6b7280; font-size: 14px;">
        If you did not request this email, you can safely ignore it.
    </p>
</div>
