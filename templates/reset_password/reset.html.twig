{% extends 'base.html.twig' %}

{% block title %}Choose a New Password - DeFake{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="text-center mb-4">
                <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                    Secure Reset
                </span>

                <h1 class="fw-bold mb-2">Choose a new password</h1>

                <p class="text-muted mb-0">
                    Use a unique password that you do not use on other services.
                </p>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    {{ form_start(resetForm) }}

                        <div class="mb-3">
                            {{ form_label(resetForm.plainPassword.first, 'New password', {
                                label_attr: {
                                    class: 'form-label fw-semibold'
                                }
                            }) }}

                            {{ form_widget(resetForm.plainPassword.first, {
                                attr: {
                                    class: 'form-control form-control-lg rounded-3',
                                    placeholder: 'Enter a new password'
                                }
                            }) }}

                            {{ form_errors(resetForm.plainPassword.first) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(resetForm.plainPassword.second, 'Repeat password', {
                                label_attr: {
                                    class: 'form-label fw-semibold'
                                }
                            }) }}

                            {{ form_widget(resetForm.plainPassword.second, {
                                attr: {
                                    class: 'form-control form-control-lg rounded-3',
                                    placeholder: 'Repeat the new password'
                                }
                            }) }}

                            {{ form_errors(resetForm.plainPassword.second) }}
                            {{ form_errors(resetForm.plainPassword) }}
                        </div>

                        <button class="btn btn-danger btn-lg w-100 rounded-3" type="submit">
                            Reset password
                        </button>

                    {{ form_end(resetForm) }}

                </div>
            </div>

        </div>
    </div>
</div>
{% endblock %}
