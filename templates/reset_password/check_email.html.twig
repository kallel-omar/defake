{% extends 'base.html.twig' %}

{% block title %}Password Reset Email Sent - DeFake{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">

            <div class="text-center mb-4">
                <span class="badge bg-danger rounded-pill px-3 py-2 mb-3">
                    Check Your Email
                </span>

                <h1 class="fw-bold mb-2">Reset link sent</h1>

                <p class="text-muted mb-0">
                    If an account exists for that email, a password reset link has been sent.
                </p>
            </div>

            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <p class="mb-3">
                        The reset link expires in
                        <strong>{{ resetToken.expirationMessageKey|trans(resetToken.expirationMessageData, 'ResetPasswordBundle') }}</strong>.
                    </p>

                    <p class="text-muted mb-4">
                        If you do not receive an email, check your spam folder or request a new reset link.
                    </p>

                    <a href="{{ path('app_forgot_password_request') }}"
                       class="btn btn-outline-danger btn-lg w-100 rounded-3">
                        Request another link
                    </a>
                </div>
            </div>

            <p class="text-center text-muted mt-3 mb-0">
                <a href="{{ path('app_login') }}" class="text-danger fw-semibold text-decoration-none">
                    Back to sign in
                </a>
            </p>

        </div>
    </div>
</div>
{% endblock %}
